{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "1. Home Page",
    "description": "Home page-এর সব section এক জায়গায় — banner, about text, project cards, intro video, recent activities, slider"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "banner": {
      "type": "component",
      "repeatable": false,
      "component": "banner-category.banner"
    },
    "aboutShortText": {
      "type": "text"
    },
    "projectsSectionTitle": {
      "type": "string",
      "default": "আমাদের প্রকল্পসমূহ"
    },
    "mosqueComplexCard": {
      "type": "component",
      "repeatable": false,
      "component": "home-page.project-card"
    },
    "kulliyaCard": {
      "type": "component",
      "repeatable": false,
      "component": "home-page.project-card"
    },
    "darulHadithCard": {
      "type": "component",
      "repeatable": false,
      "component": "home-page.project-card"
    },
    "founderMessage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::founder-message.founder-message"
    },
    "introVideo": {
      "type": "component",
      "repeatable": false,
      "component": "home-page.intro-video"
    },
    "recentActivities": {
      "type": "component",
      "repeatable": true,
      "component": "home-page.recent-activity"
    },
    "slider": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
