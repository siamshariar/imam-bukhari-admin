{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Courses",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "displayHome": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "courseDetail": {
      "type": "component",
      "repeatable": true,
      "component": "courses-category.course-detail"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "excerpt": {
      "type": "text"
    },
    "courseFee": {
      "type": "component",
      "repeatable": true,
      "component": "courses-category.course-fee"
    },
    "examSchedule": {
      "type": "component",
      "repeatable": true,
      "component": "courses-category.exam-schedule"
    }
  }
}
